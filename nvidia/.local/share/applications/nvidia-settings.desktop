[Desktop Entry]
Type=Application
Name=NVIDIA X Server Settings
Comment=Configure NVIDIA X Server Settings
# Desktop launchers may not have ~/.local/bin in PATH.
Exec=/bin/sh -c "exec \\"\\$HOME/.local/bin/nvidia-settings\\""
Icon=nvidia-settings
Categories=System;Settings;

