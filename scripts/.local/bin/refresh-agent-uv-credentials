#!/usr/bin/env python3
"""Refresh one trusted customer's plaintext uv credential store (Python 3.11+)."""

import ipaddress
import os
from pathlib import Path
import re
import subprocess
import sys
import tomllib
from urllib.parse import urlsplit


class RefreshError(Exception):
    """A safe, credential-free diagnostic."""


def xdg_directory(variable: str, fallback: str) -> Path:
    value = os.environ.get(variable, "")
    return Path(value) if Path(value).is_absolute() else Path.home() / fallback


def valid_hostname(hostname: str | None) -> bool:
    if not hostname:
        return False
    try:
        ipaddress.ip_address(hostname)
        return True
    except ValueError:
        pass
    try:
        hostname = hostname.encode("idna").decode("ascii").removesuffix(".")
    except UnicodeError:
        return False
    return len(hostname) <= 253 and all(
        re.fullmatch(r"[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?", label)
        for label in hostname.split(".")
    )


def load_config(path: Path) -> dict:
    try:
        with path.open("rb") as source:
            config = tomllib.load(source)
    except (OSError, ValueError):
        raise RefreshError("configuration could not be read or parsed") from None

    required = {"service", "username", "command"}
    if not required <= config.keys() or config.keys() - required - {"environment"}:
        raise RefreshError("configuration has missing or unknown fields")
    service = config["service"]
    if (
        not isinstance(service, str)
        or not service
        or any(character.isspace() or ord(character) < 32 for character in service)
    ):
        raise RefreshError("service must be an HTTPS origin")
    try:
        origin = urlsplit(service)
        valid_origin = (
            service.startswith("https://")
            and origin.scheme == "https"
            and valid_hostname(origin.hostname)
            and re.fullmatch(
                r"(?:\[[0-9a-fA-F:.]+\]|[^:\[\]]+)(?::[0-9]+)?", origin.netloc
            )
            and origin.username is None
            and origin.password is None
            and origin.path in ("", "/")
            and not origin.query
            and not origin.fragment
            and "?" not in service
            and "#" not in service
            and "\\" not in service
            and "%" not in origin.netloc
            and not origin.netloc.endswith(":")
        )
        origin.port  # Validate any explicit port.
    except ValueError:
        valid_origin = False
    if not valid_origin:
        raise RefreshError("service must be an HTTPS origin")
    username = config["username"]
    if not isinstance(username, str) or not username.strip() or "\0" in username:
        raise RefreshError("username must be a nonempty string")
    command = config["command"]
    if (
        not isinstance(command, list)
        or not command
        or not all(isinstance(arg, str) and "\0" not in arg for arg in command)
        or not command[0]
    ):
        raise RefreshError("command must be a nonempty argv string array")
    environment = config.get("environment", {})
    if not isinstance(environment, dict) or not all(
        isinstance(key, str)
        and key
        and "=" not in key
        and "\0" not in key
        and isinstance(value, str)
        and "\0" not in value
        for key, value in environment.items()
    ):
        raise RefreshError("environment must map valid variable names to strings")
    return config


def run_stage(stage: str, command: list[str], environment: dict[str, str], **kwargs):
    try:
        result = subprocess.run(
            command, env=environment, stderr=subprocess.DEVNULL, check=False, **kwargs
        )
    except (OSError, ValueError):
        raise RefreshError(f"{stage} could not start") from None
    if result.returncode:
        raise RefreshError(f"{stage} failed (exit {result.returncode})")
    return result


def refresh(customer: str) -> None:
    if re.fullmatch(r"[a-z0-9][a-z0-9_-]*", customer) is None:
        raise RefreshError("invalid customer ID")
    config_path = (
        xdg_directory("XDG_CONFIG_HOME", ".config")
        / "agent-uv-auth"
        / f"{customer}.toml"
    )
    config = load_config(config_path)
    environment = os.environ.copy()
    for key, value in config.get("environment", {}).items():
        if value == "~" or value.startswith("~/"):
            value = str(Path.home()) + value[1:]
        environment[key] = value

    acquired = run_stage(
        "token acquisition",
        config["command"],
        environment,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
    )
    token = acquired.stdout.strip()
    if not token:
        raise RefreshError("token acquisition returned an empty token")

    store = (
        xdg_directory("XDG_DATA_HOME", ".local/share")
        / "uv"
        / "agent-credentials"
        / customer
    )
    try:
        store.mkdir(mode=0o700, parents=True, exist_ok=True)
        descriptor = os.open(store, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            os.fchmod(descriptor, 0o700)
        finally:
            os.close(descriptor)
    except OSError:
        raise RefreshError("credential store could not be prepared") from None

    environment["UV_CREDENTIALS_DIR"] = str(store)
    environment["UV_KEYRING_PROVIDER"] = "disabled"
    environment.pop("UV_PREVIEW", None)
    environment.pop("UV_PREVIEW_FEATURES", None)
    environment.pop("UV_CONFIG_FILE", None)
    run_stage(
        "uv login",
        [
            "uv",
            "--no-config",
            "--no-preview",
            "auth",
            "login",
            config["service"],
            "--username",
            config["username"],
            "--password",
            "-",
        ],
        environment,
        input=token + b"\n",
        stdout=subprocess.DEVNULL,
    )


def main() -> int:
    os.umask(0o077)
    if len(sys.argv) != 2:
        print("Usage: refresh-agent-uv-credentials CUSTOMER", file=sys.stderr)
        return 2
    try:
        refresh(sys.argv[1])
    except RefreshError as error:
        print(f"Credential refresh: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("Credential refresh interrupted", file=sys.stderr)
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
