
export QT_QPA_PLATFORM="wayland"
export SDL_VIDEODRIVER="wayland"
export XDG_CURRENT_DESKTOP="Hyprland"
export XDG_SESSION_TYPE="wayland"
export XDG_SESSION_DESKTOP="Hyprland"
export GDK_BACKEND=wayland
export ELECTRON_OZONE_PLATFORM_HINT=auto 

export XCURSOR_THEME="catppuccin-mocha-blue-cursors"
export XCURSOR_SIZE="28"
export GDK_SCALE="2"

. "${XDG_CONFIG_HOME:-$HOME/.config}/shell/tool-paths.sh"
export GOPATH="$HOME/.local/share/go"

# AWS — kept here (not just in fish/conf.d/aws.fish) so emacs.service and
# every other graphical-session unit inherits them. uwsm sources this file
# at session start and pushes the delta into the systemd user activation
# environment, from which foot-server (and the fish shells it spawns)
# inherits too.
export AWS_CONFIG_FILE="$HOME/.config/aws/config"
export AWS_SHARED_CREDENTIALS_FILE="$HOME/.config/aws/credentials"
