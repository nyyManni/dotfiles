;;; consult-agent-shell-sessions-tests.el --- Picker tests -*- lexical-binding: t -*-

(require 'ert)
(require 'consult-agent-shell-sessions)

(ert-deftest consult-agent-shell-sessions-snapshot-and-selection ()
  (let ((buffer (generate-new-buffer "test shell picker"))
        (snapshot-count 0)
        (displayed nil)
        (status (propertize "Ready" 'face 'success)))
    (unwind-protect
        (cl-letf (((symbol-function 'agent-shell-manager--entries)
                   (lambda ()
                     (cl-incf snapshot-count)
                     (list (list buffer (vector "[Codex] Picker" status "Default"
                                                "Model" "-" "~/project/")))))
                  ((symbol-function 'consult--read)
                   (lambda (candidates &rest options)
                     (should (= snapshot-count 1))
                     (should-not (plist-get options :sort))
                     (should (plist-get options :require-match))
                     (let ((row (caar candidates)))
                       (dolist (field '("[Codex] Picker" "Ready" "Default" "Model" "~/project/"))
                         (should (string-match-p (regexp-quote field) row)))
                       (should (eq (get-text-property (string-match "Ready" row) 'face row)
                                   'success))
                       ;; The buffer object remains valid if its name changes.
                       (with-current-buffer buffer (rename-buffer "test shell renamed"))
                       (funcall (plist-get options :lookup) row candidates))))
                  ((symbol-function 'get-buffer-window) (lambda (&rest _) nil))
                  ((symbol-function 'agent-shell--display-buffer)
                   (lambda (selected) (setq displayed selected))))
          (consult-agent-shell-sessions)
          (should (= snapshot-count 1))
          (should (eq displayed buffer)))
      (kill-buffer buffer))))

(ert-deftest consult-agent-shell-sessions-empty ()
  (cl-letf (((symbol-function 'agent-shell-manager--entries) (lambda () nil))
            ((symbol-function 'consult--read) (lambda (&rest _) (ert-fail "Unexpected prompt"))))
    (should-error (consult-agent-shell-sessions) :type 'user-error)))

(ert-deftest consult-agent-shell-sessions-killed-during-selection ()
  (let ((buffer (generate-new-buffer "test shell killed")))
    (unwind-protect
        (cl-letf (((symbol-function 'agent-shell-manager--entries)
                   (lambda () (list (list buffer ["Shell" "Ready" "-" "-" "-" "~/"]))))
                  ((symbol-function 'consult--read)
                   (lambda (&rest _) (kill-buffer buffer) buffer))
                  ((symbol-function 'agent-shell--display-buffer)
                   (lambda (&rest _) (ert-fail "Displayed a dead buffer"))))
          (should-error (consult-agent-shell-sessions) :type 'user-error))
      (when (buffer-live-p buffer) (kill-buffer buffer)))))

(ert-deftest consult-agent-shell-sessions-cancellation ()
  (cl-letf (((symbol-function 'agent-shell-manager--entries)
             (lambda () (list (list (current-buffer) ["Shell" "Ready" "-" "-" "-" "~/"]))))
            ((symbol-function 'consult--read) (lambda (&rest _) (signal 'quit nil)))
            ((symbol-function 'agent-shell--display-buffer)
             (lambda (&rest _) (ert-fail "Displayed a buffer after cancellation"))))
    (should (eq (condition-case nil
                    (progn (consult-agent-shell-sessions) 'not-cancelled)
                  (quit 'cancelled))
                'cancelled))))

(ert-deftest consult-agent-shell-sessions-focuses-existing-window ()
  (let ((buffer (generate-new-buffer "test visible shell"))
        (window (selected-window))
        (focused-frame nil)
        (focused-window nil))
    (unwind-protect
        (cl-letf (((symbol-function 'agent-shell-manager--entries)
                   (lambda () (list (list buffer ["Shell" "Ready" "-" "-" "-" "~/"]))))
                  ((symbol-function 'consult--read) (lambda (&rest _) buffer))
                  ((symbol-function 'get-buffer-window)
                   (lambda (selected &optional _) (should (eq selected buffer)) window))
                  ((symbol-function 'select-frame-set-input-focus)
                   (lambda (frame &rest _) (setq focused-frame frame)))
                  ((symbol-function 'select-window)
                   (lambda (selected &rest _) (setq focused-window selected)))
                  ((symbol-function 'agent-shell--display-buffer)
                   (lambda (&rest _) (ert-fail "Created a display for a visible session"))))
          (consult-agent-shell-sessions)
          (should (eq focused-frame (window-frame window)))
          (should (eq focused-window window)))
      (kill-buffer buffer))))

(ert-deftest consult-agent-shell-sessions-identical-titles-select-distinct-buffers ()
  (let ((first (generate-new-buffer "test same title"))
        (second (generate-new-buffer "test same title")))
    (unwind-protect
        (let* ((rows (consult-agent-shell-sessions--candidates
                      (list (list first ["ETL iteration" "Ready" "-" "-" "-" "~/etl/"])
                            (list second ["ETL iteration" "Ready" "-" "-" "-" "~/etl/"]))))
               (first-label (caar rows))
               (second-label (caadr rows)))
          (should-not (equal first-label second-label))
          (should (eq (consult--lookup-cdr first-label rows) first))
          (should (eq (consult--lookup-cdr second-label rows) second)))
      (kill-buffer first)
      (kill-buffer second))))

(provide 'consult-agent-shell-sessions-tests)
;;; consult-agent-shell-sessions-tests.el ends here
