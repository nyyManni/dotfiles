;;; nyy-agent-shell-mcp-tests.el --- Project MCP tests -*- lexical-binding: t -*-

(require 'ert)
(require 'cl-lib)
(require 'nyy-agent-shell-mcp)

(defvar nyy/mcp-test-optional '("atlassian" "aws-mcp" "plane" "customer-mcp"))
(defvar nyy/mcp-test-roots '(("customer-mcp" . ("/tmp/customer/"))))

(defun nyy/mcp-test-servers ()
  "Return test definitions without real commands or credentials."
  (mapcar (lambda (name) `((name . ,name) (command . "unused")))
          '("emacs" "agent-lsp" "githits" "aws-mcp" "atlassian" "plane" "brave-search" "customer-mcp")))

(defun nyy/mcp-test-names (extras &optional override directory)
  "Return server names selected by EXTRAS, OVERRIDE, and DIRECTORY."
  (let ((agent-shell-mcp-servers (nyy/mcp-test-servers))
        (nyy/agent-shell-mcp-optional-servers nyy/mcp-test-optional)
        (nyy/agent-shell-mcp-server-roots nyy/mcp-test-roots)
        (agent-shell--state `((:agent-config . ((:mcp-servers . ,override)))))
        (process-environment (copy-sequence process-environment))
        (direnv-mode nil))
    (setenv "AGENT_SHELL_MCP_EXTRAS" extras)
    (cl-letf (((symbol-function 'agent-shell-cwd)
               (lambda () (or directory "/tmp/"))))
      (mapcar (lambda (server) (map-elt server 'name))
              (append (agent-shell--mcp-servers) nil)))))

(ert-deftest nyy/mcp-environment-selection ()
  (let ((global '("emacs" "agent-lsp" "githits" "brave-search")))
    (should (equal (nyy/mcp-test-names nil) global))
    (should (equal (nyy/mcp-test-names "") global))
    (should (equal (nyy/mcp-test-names "atlassian")
                   '("emacs" "agent-lsp" "githits" "atlassian" "brave-search")))
    (dolist (extras '("aws,plane" " aws-mcp, plane " "aws plane plane"))
      (should (equal (nyy/mcp-test-names extras)
                     '("emacs" "agent-lsp" "githits" "aws-mcp" "plane" "brave-search"))))
    ;; Directory names alone no longer enable customer servers.
    (should (equal (nyy/mcp-test-names nil nil "/tmp/customer/")
                   global))))

(ert-deftest nyy/mcp-filters-before-credentials-and-preserves-overrides ()
  (let* ((forbidden '((name . "atlassian") (command . "unused")
                      (env . (lambda () (error "Forbidden credential read")))))
         (override (list forbidden '((name . "plane") (command . "unused"))))
         (agent-shell--state `((:agent-config . ((:mcp-servers . ,override)))))
          (agent-shell-mcp-servers (nyy/mcp-test-servers))
          (nyy/agent-shell-mcp-optional-servers nyy/mcp-test-optional)
          (nyy/agent-shell-mcp-server-roots nyy/mcp-test-roots)
         (original-state (copy-tree agent-shell--state))
         (original-global (copy-tree agent-shell-mcp-servers))
         (process-environment (copy-sequence process-environment))
         (direnv-mode nil))
    (setenv "AGENT_SHELL_MCP_EXTRAS" "plane")
    (cl-letf (((symbol-function 'agent-shell-cwd) (lambda () "/tmp/")))
      (should (equal (mapcar (lambda (server) (map-elt server 'name))
                            (append (agent-shell--mcp-servers) nil))
                     '("plane"))))
    (should (equal agent-shell--state original-state))
    (should (equal agent-shell-mcp-servers original-global))
    (should-not (nyy/mcp-test-names nil (list forbidden)))))

(ert-deftest nyy/mcp-refreshes-direnv-for-each-session ()
  (let ((agent-shell-mcp-servers (nyy/mcp-test-servers))
        (nyy/agent-shell-mcp-optional-servers nyy/mcp-test-optional)
        (nyy/agent-shell-mcp-server-roots nyy/mcp-test-roots)
        (agent-shell--state nil)
        (process-environment (copy-sequence process-environment))
        (direnv-mode t)
        (directory "/tmp/vendor/")
        refreshed)
    (setenv "AGENT_SHELL_MCP_EXTRAS" "aws,plane")
    (cl-letf (((symbol-function 'agent-shell-cwd) (lambda () directory))
              ((symbol-function 'direnv-update-directory-environment)
               (lambda (cwd &optional _summary)
                 (push cwd refreshed)
                 (should (equal default-directory cwd))
                 (setenv "AGENT_SHELL_MCP_EXTRAS"
                          (when (equal cwd "/tmp/vendor/") "atlassian")))))
      (should (equal (mapcar (lambda (s) (map-elt s 'name))
                            (append (agent-shell--mcp-servers) nil))
                     '("emacs" "agent-lsp" "githits" "atlassian" "brave-search")))
      (setq directory "/tmp/other/")
      (should (equal (mapcar (lambda (s) (map-elt s 'name))
                            (append (agent-shell--mcp-servers) nil))
                     '("emacs" "agent-lsp" "githits" "brave-search")))
      (should (equal refreshed '("/tmp/other/" "/tmp/vendor/"))))))

(ert-deftest nyy/mcp-remote-session-does-not-inherit-local-extras ()
   (should (equal (nyy/mcp-test-names "aws,plane,atlassian,customer-mcp" nil "/ssh:example:/tmp/")
                  '("emacs" "agent-lsp" "githits" "brave-search"))))

(ert-deftest nyy/mcp-customer-directory-restriction ()
  (let* ((global '("emacs" "agent-lsp" "githits" "brave-search"))
         (root (make-temp-file "nyy-mcp-policy-" t))
         (customer (expand-file-name "customer/" root))
         (project (expand-file-name "project/" customer))
         (other (expand-file-name "customer-other/" root))
         (escape (expand-file-name "escape/" customer))
         (nyy/mcp-test-roots `(("customer-mcp" . (,customer)))))
    (unwind-protect
        (progn
          (make-directory project t)
          (make-directory other t)
          (make-symbolic-link other (directory-file-name escape))
          (dolist (directory (list customer project))
            (should (equal (nyy/mcp-test-names "customer-mcp" nil directory)
                           (append global '("customer-mcp"))))
            (should (equal (nyy/mcp-test-names nil nil directory) global)))
          (dolist (directory (list root other escape "/ssh:example:/tmp/customer/"))
            (should (equal (nyy/mcp-test-names "customer-mcp" nil directory) global))))
      (delete-directory root t))))

(ert-deftest nyy/mcp-restricted-override-still-checks-directory ()
  (let ((server '((name . "customer-mcp") (command . "unused")
                  (env . (lambda () (error "Forbidden credential read"))))))
    (should-not (nyy/mcp-test-names "customer-mcp" (list server) "/tmp/other/"))))

